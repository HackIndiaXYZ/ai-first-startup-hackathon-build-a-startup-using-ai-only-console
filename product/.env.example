# Live AI extraction. Server-side only. Leave blank for the synthetic demo and CSV import.
AI_PROVIDER=fireworks
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/kimi-k2p6
# Switch AI_PROVIDER to openai to use the retained OpenAI Responses API adapter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Global AI requests per UTC day, shared across all visitors. 0 pauses AI requests.
AI_DAILY_REQUEST_LIMIT=30
